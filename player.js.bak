/* FBFLIX Pages player — static version.
 * Query params:
 *   v  = video URL (http...) OR video ID (then /refresh is used)
 *   t  = title
 *   id = video ID (localStorage key for resume)
 *   s  = start position in seconds
 *   p  = poster image URL (optional)
 */
(function(){
'use strict';

var CATALOG_API = 'https://nova-catalog.oshadakalindu.workers.dev';
var APP_KEY = '7580ce70c2f66f3c9b04de2bedb879b7'; // replaced at build time

var q = new URLSearchParams(location.search);
var vParam = q.get('v') || '';
var videoTitle = q.get('t') || 'FBFLIX';
var videoId = q.get('id') || '';
var posterParam = q.get('p') || '';
var startS = parseFloat(q.get('s') || '0');

var tapOverlay = document.getElementById('tapOverlay');
var tapTitle = document.getElementById('tapTitle');
var tapSub = document.getElementById('tapSub');
var statusEl = document.getElementById('status');
var plyrWrap = document.getElementById('plyrWrap');
var video = document.getElementById('video');

document.title = videoTitle + ' - FBFLIX';
if (tapTitle) tapTitle.textContent = videoTitle;

function setStatus(msg) {
  if (statusEl) { statusEl.style.display = 'block'; statusEl.textContent = msg; }
}

// localStorage resume: prefer the larger of URL s param vs saved position
if (videoId) {
  try {
    var saved = localStorage.getItem('fbflix_pos_' + videoId);
    if (saved) {
      var data = JSON.parse(saved);
      var age = Date.now() - (data.updated || 0);
      if (data.pos > 30 && data.dur > 0 && data.pos < data.dur - 60 && age < 30*24*60*60*1000) {
        if (data.pos > startS) startS = data.pos;
      }
    }
  } catch(e) {}
}

// Apply poster to overlay background
function applyPoster(url) {
  if (!url) return;
  tapOverlay.style.backgroundImage = "url('" + url + "')";
  window._posterUrl = url;
}
if (posterParam) applyPoster(posterParam);

// Resolve the playable video URL:
// 1. If v looks like a URL, use it directly (current app behavior).
// 2. Otherwise treat v as a video ID and call /refresh (needs CORS on worker).
function resolveVideoUrl() {
  if (/^https?:\/\//i.test(vParam)) return Promise.resolve(vParam);
  var vid = videoId || vParam;
  if (!vid) return Promise.reject(new Error('missing video'));
  return fetch(CATALOG_API + '/refresh', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-App-Key': APP_KEY },
    body: JSON.stringify({ id: vid })
  }).then(function(r){
    if (!r.ok) throw new Error('refresh ' + r.status);
    return r.json();
  }).then(function(j){
    if (!j.url) throw new Error('no url');
    return j.url;
  });
}

// Try to fetch poster from public catalog when not supplied via ?p=
function maybeFetchPoster() {
  if (posterParam || window._posterUrl) return;
  var vid = videoId || vParam;
  if (!vid || /^https?:\/\//i.test(vid)) return;
  fetch(CATALOG_API + '/catalog', { headers: { 'X-App-Key': APP_KEY } })
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(j){
      if (!j || !j.items) return;
      for (var i = 0; i < j.items.length; i++) {
        if (j.items[i].id === vid && j.items[i].poster) { applyPoster(j.items[i].poster); break; }
      }
    }).catch(function(){});
}
maybeFetchPoster();

// ---- position tracking (localStorage primary, server backup) ----
var _plyrPlayer = null;
var _saveInterval = null;

function savePositionLocal(player) {
  player = player || _plyrPlayer;
  if (!player || !videoId) return;
  var dur = player.duration || 0;
  if (!dur) return;
  var pos = player.currentTime || 0;
  if (pos < 10) return;
  try {
    localStorage.setItem('fbflix_pos_' + videoId,
      JSON.stringify({ pos: Math.floor(pos), dur: Math.floor(dur), updated: Date.now() }));
  } catch(e) {}
}
function startPeriodicSave(player) {
  if (_saveInterval) clearInterval(_saveInterval);
  _saveInterval = setInterval(function(){ if (player && !player.paused) savePositionLocal(player); }, 10000);
}
function stopPeriodicSave() {
  if (_saveInterval) { clearInterval(_saveInterval); _saveInterval = null; }
}
function reportPosition(player) {
  player = player || _plyrPlayer;
  if (!player || !videoId) return;
  var dur = player.duration || 0;
  if (!dur) return;
  var pos = player.currentTime || 0;
  if (pos < 10 || pos > dur - 30) return;
  var payload = JSON.stringify({ id: videoId, position: Math.floor(pos), duration: Math.floor(dur) });
  if (navigator.sendBeacon) {
    navigator.sendBeacon(CATALOG_API + '/api/position', new Blob([payload], { type: 'application/json' }));
  } else {
    fetch(CATALOG_API + '/api/position', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: payload, keepalive: true
    }).catch(function(){});
  }
}
window.addEventListener('pagehide', function(){ reportPosition(); });
window.addEventListener('beforeunload', function(){ reportPosition(); });
document.addEventListener('visibilitychange', function(){ if (document.hidden) reportPosition(); });

// ---- tap-to-play ----
var _started = false;
tapOverlay.addEventListener('pointerup', function(e){
  e.preventDefault();
  if (_started) return;
  _started = true;
  setStatus('Loading…');

  resolveVideoUrl().then(function(videoUrl){
    setStatus('');
    tapOverlay.classList.add('hidden');
    plyrWrap.classList.add('show');

    if (window._posterUrl) {
      document.body.style.backgroundImage = "url('" + window._posterUrl + "')";
      document.body.style.backgroundSize = "cover";
      document.body.style.backgroundPosition = "center";
    }

    var player = new Plyr(video, {
      controls: ['play-large', 'play', 'progress', 'current-time', 'duration', 'mute', 'volume', 'settings', 'pip', 'fullscreen'],
      settings: ['speed'],
      speed: { selected: 1, options: [0.5, 0.75, 1, 1.25, 1.5, 2] },
      fullscreen: { enabled: true, fallback: true, iosNative: true }
    });

    player.source = { type: 'video', sources: [{ src: videoUrl, type: 'video/mp4' }] };

    if (startS > 0) {
      player.on('loadedmetadata', function(){ player.currentTime = startS; });
    }

    function doRotate(){
      if (screen.orientation && screen.orientation.lock) {
        screen.orientation.lock('landscape').catch(function(){});
      }
    }
    player.on('enterfullscreen', function(){
      if (screen.orientation && screen.orientation.lock) {
        screen.orientation.lock('landscape').catch(function(){});
      }
    });
    player.on('exitfullscreen', function(){
      if (screen.orientation && screen.orientation.unlock) screen.orientation.unlock();
    });

    _plyrPlayer = player;
    player.on('play', function(){ startPeriodicSave(player); });
    player.on('pause', function(){ stopPeriodicSave(); savePositionLocal(player); });
    player.on('ended', function(){
      stopPeriodicSave();
      try { localStorage.removeItem('fbflix_pos_' + videoId); } catch(e) {}
    });
    player.on('ready', function(){
      if (player.fullscreen && player.fullscreen.enter) player.fullscreen.enter();
      doRotate();
      player.on('playing', function(){ document.body.style.backgroundImage = 'none'; });
      player.on('pause', function(){ reportPosition(player); });
      player.on('ended', function(){ reportPosition(player); });
      document.addEventListener('visibilitychange', function(){
        if (document.hidden) reportPosition(player);
      });
      player.play().catch(function(){});
    });
  }).catch(function(err){
    _started = false;
    setStatus('Could not load video. ' + (err && err.message ? err.message : ''));
    if (tapSub) tapSub.textContent = 'Tap to retry';
  });
});
})();
// deploy 1793801114
